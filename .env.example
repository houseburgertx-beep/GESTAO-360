# ==========================================================
# BrassaOps - Variáveis de Ambiente (.env.local)
# Copie este arquivo para .env.local e preencha quando for
# conectar ao seu projeto Supabase e à sua loja na Takeat.
# Sem preencher, o app roda automaticamente em Modo Demo!
# ==========================================================

# --- Supabase (Banco PostgreSQL + Auth + Storage de Fotos) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- API Pública Oficial da Takeat (Apenas Server-Side) ---
# Base URL oficial de produção: https://public-api.takeat.app
TAKEAT_API_BASE_URL=https://public-api.takeat.app
# Modo de operação: "demo" (padrão) ou "live"
TAKEAT_MODE=demo
# Chave de integração obtida no painel Takeat (somente no servidor, nunca com NEXT_PUBLIC_)
TAKEAT_API_KEY=
# ID numérico da loja retornado em GET /v1/restaurants (obrigatório em multilojas)
TAKEAT_RESTAURANT_ID=
# Escopos solicitados no POST /oauth/token (separados por espaço)
TAKEAT_SCOPES="inputs:read inputs:stock:write intermediaries:read intermediaries:stock:write products:read complements:read reports:products:read reports:payments:read reports:kds:read nfe-received:read"

# --- Web Push (Opcional para notificações no celular) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
